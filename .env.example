# ===============================================
# PROJECT BLOC - ENVIRONMENT CONFIGURATION
# ===============================================

# 1. TURSO DATABASE (libSQL Edge DB)
# Create database at: https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# 2. GOOGLE CLOUD VERTEX AI & GEMINI 2.5
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=asia-southeast1 # Singapore
# Model designations
GEMINI_FLASH_MODEL=gemini-2.5-flash # Pax (Fast Chat & Translation) & Nexus
GEMINI_PRO_MODEL=gemini-2.5-pro     # Vera (Multimodal Shelf & Pitch Vision)

# 3. GOOGLE WORKSPACE TRI-PILLAR INTEGRATION
# Base64-encoded Service Account JSON key or local file path
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
# Root 5TB Google Drive Folder ID for Media Vault
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id
# Operations Google Sheet ID for 2-way sync
GOOGLE_SHEETS_SYNC_ID=your-google-sheets-spreadsheet-id

# 4. SERVER & AUTH CONFIGURATION
PORT=8080
NODE_ENV=development
NEXTAUTH_SECRET=generate-random-secret-here
